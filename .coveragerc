[run]
source = grplot
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */grplot.egg-info/*
    */grplot_seaborn/*
    setup.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstract
precision = 2

[html]
directory = htmlcov
